# Copy to .env (not committed). compose.yaml reads it.
# IP whitelist (comma separated IPs/CIDRs). Empty = every IP allowed.
# /, /health, /whoami and /spse/... stay open to everyone.
SPSE_ALLOWED_IPS=43.134.90.65,34.50.127.37,43.157.228.227,43.173.50.220
# Reverse proxies in front that append X-Forwarded-For. 0 when reached directly (local testing).
SPSE_PROXY_HOPS=1
# Optional: a trusted proxy's header holding the client IP alone. Empty = use X-Forwarded-For.
SPSE_CLIENT_IP_HEADER=
# Public address used for buka_url links.
SPSE_PUBLIC_URL=https://data-spse.latindo.ai.id
# Detail jobs running at the same time.
SPSE_MAX_JOBS=2
